# Copy to .env and adjust. docker compose reads .env automatically.

# PostgreSQL
POSTGRES_USER=yozigo
POSTGRES_PASSWORD=yozigo_dev_password
POSTGRES_DB=yozigo
# Host port for PostgreSQL (5433 avoids clashing with a locally installed Postgres)
DB_HOST_PORT=5433

# API
APP_ENV=development
CINEMA_TIMEZONE=Asia/Kolkata
# Run the idempotent seed (demo accounts, movies, shows) on API start-up
SEED_ON_START=true
# Cookies marked Secure are sent only over HTTPS. Set to true behind HTTPS in production.
COOKIE_SECURE=false

# DEMO LOGIN — only for an isolated local/demo environment. Never enable in production
# (the API refuses to start with DEMO_LOGIN_ENABLED=true and APP_ENV=production).
DEMO_LOGIN_ENABLED=true
# Password given to the four seeded demo accounts (for the normal login form)
DEMO_PASSWORD=yozigo-demo

# Host port for the web app
WEB_HOST_PORT=3000
